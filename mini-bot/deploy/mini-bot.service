# The VPSM agent as a systemd service. Installed by install.sh.
#
# Runs as root because per-process disk I/O needs PTRACE_MODE_READ on other
# users' processes; without it that column reads "not measured". Everything
# else the agent does is reading /proc and writing its spool, and the
# sandboxing below holds it to exactly that: no network at all (the
# collector pulls over SSH by running `mini-bot export` as a login user),
# a read-only filesystem apart from the spool, and a memory ceiling far
# above its ~1 MiB working set.

[Unit]
Description=VPSM monitoring agent (mini-bot)
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/local/bin/mini-bot
EnvironmentFile=/etc/vpsm/mini-bot.env
Restart=on-failure
RestartSec=10

# Group-shared spool: see install.sh.
UMask=0007

# Never compete with the workload it is watching.
Nice=10
IOSchedulingClass=idle
MemoryMax=64M

ProtectSystem=strict
ReadWritePaths=/var/lib/vpsm
# Read-only rather than hidden, so a separate /home mount still reports its
# capacity.
ProtectHome=read-only
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# It reads files and writes files. No sockets of any kind.
RestrictAddressFamilies=none
IPAddressDeny=any

[Install]
WantedBy=multi-user.target
